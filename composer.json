{
    "name": "chronhub/storm-serializer",
    "description": "Storm Serializer — the explicit codec between a Message and its {header, content} form.",
    "type": "library",
    "license": "MIT",
    "keywords": ["ddd", "cqrs", "event-sourcing", "serializer"],
    "require": {
        "php": ">=8.5",
        "ext-sodium": "*",
        "chronhub/storm-contracts": "self.version",
        "chronhub/storm-message": "self.version",
        "symfony/dependency-injection": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^13.3.0"
    },
    "autoload": {
        "psr-4": {
            "Storm\\Serializer\\": "./"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Storm\\Serializer\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
